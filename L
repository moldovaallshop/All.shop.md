
<!doctype html>
<html lang="ro">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#ffffff">
<meta name="description" content="All.Shop.MD — haine și stil. În curând.">
<title>All.Shop.MD — În curând</title>
<style>
:root{--ink:#171717;--yellow:#e6c200;--line:#ececec}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
margin:0;min-height:100vh;display:flex;flex-direction:column;
background:#fff;color:var(--ink);
font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
-webkit-font-smoothing:antialiased
}
a{color:inherit;text-decoration:none}
.shell{width:min(1120px,calc(100% - 64px));margin-inline:auto}
header{
min-height:82px;display:flex;align-items:center;justify-content:space-between;
border-bottom:1px solid var(--line);animation:fade .75s both
}
.logo{font-size:21px;font-weight:850;letter-spacing:-1.2px}
.logo span{color:#b59a00}
.top-note{color:#777;font-size:11px;letter-spacing:1.8px;text-transform:uppercase}
main{flex:1;display:grid;place-items:center;padding:78px 0 88px}
.hero{width:100%;max-width:850px;text-align:center}
.eyebrow{
display:inline-flex;align-items:center;gap:10px;color:#777;
font-size:11px;font-weight:650;letter-spacing:2.8px;text-transform:uppercase;
animation:fade .75s .08s both
}
.eyebrow:before,.eyebrow:after{
content:"";width:23px;height:1px;background:#d8d8d8
}
h1{
margin:27px 0 0;font-size:clamp(55px,10vw,118px);
line-height:.93;letter-spacing:-.08em;font-weight:850;
animation:rise .9s .12s both
}
.accent{color:var(--yellow)}
.intro{
max-width:470px;margin:24px auto 0;color:#777;
font-size:clamp(14px,1.8vw,16px);line-height:1.85;
animation:fade .75s .22s both
}
.launch{
display:inline-flex;align-items:center;gap:10px;margin-top:29px;
border:1px solid #eee5b8;background:#fffdf4;border-radius:999px;
padding:13px 18px;font-size:11px;font-weight:750;letter-spacing:1.5px;
animation:fade .75s .3s both
}
.pulse{
width:7px;height:7px;border-radius:50%;background:var(--yellow);
animation:pulse 2s infinite
}
.about{
max-width:510px;margin:65px auto 0;padding-top:23px;
border-top:1px solid var(--line);animation:fade .75s .38s both
}
.about h2{margin:0 0 10px;font-size:12px;letter-spacing:2px;text-transform:uppercase}
.about p{margin:0;color:#858585;font-size:13px;line-height:1.9}
footer{
border-top:1px solid var(--line);padding:25px 0 20px;
animation:fade .75s .45s both
}
.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:24px}
.copyright{color:#999;font-size:11px;white-space:nowrap}
.socials{display:flex;align-items:center;gap:12px}
.social{
display:inline-flex;align-items:center;justify-content:center;gap:10px;
min-width:145px;min-height:54px;padding:15px 22px;
border:1px solid #e7e7e7;border-radius:12px;background:#fff;
font-size:14px;font-weight:700;color:#222;
transition:transform .22s,border-color .22s,box-shadow .22s
}
.social:hover{
transform:translateY(-3px);border-color:#d8bd25;
box-shadow:0 8px 24px rgba(0,0,0,.06)
}
.social:focus-visible{outline:2px solid var(--yellow);outline-offset:4px}
.social svg{width:19px;height:19px;flex:none}
@keyframes fade{
from{opacity:0;transform:translateY(9px)}
to{opacity:1;transform:translateY(0)}
}
@keyframes rise{
from{opacity:0;transform:translateY(22px)}
to{opacity:1;transform:translateY(0)}
}
@keyframes pulse{
0%{box-shadow:0 0 0 0 rgba(230,194,0,.4)}
70%{box-shadow:0 0 0 7px rgba(230,194,0,0)}
100%{box-shadow:0 0 0 0 rgba(230,194,0,0)}
}
@media(max-width:700px){
.shell{width:calc(100% - 36px)}
header{min-height:70px}
.logo{font-size:19px}
.top-note{font-size:9px;letter-spacing:1px}
main{padding:67px 0 70px}
h1{font-size:clamp(51px,13.7vw,78px);letter-spacing:-.075em}
.intro{max-width:330px}
.about{max-width:360px;margin-top:52px}
footer{padding:22px 0}
.footer-inner{flex-direction:column-reverse;gap:20px}
.socials{width:100%;display:grid;grid-template-columns:1fr;gap:10px}
.social{width:100%;min-height:56px;font-size:15px}
.copyright{text-align:center}
}
@media(min-width:701px) and (max-width:900px){
.shell{width:calc(100% - 44px)}
.social{min-width:125px;padding-inline:16px}
}
@media(prefers-reduced-motion:reduce){
*,*::before,*::after{
animation-duration:.01ms!important;
animation-iteration-count:1!important;
scroll-behavior:auto!important;
transition-duration:.01ms!important
}
}
</style>
</head>
